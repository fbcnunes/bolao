generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  MASTER
  PARTICIPANTE
}

enum BolaoStatus {
  PENDENTE
  ATIVO
  RECUSADO
  EXCLUIDO
}

enum MemberRole {
  ADMIN
  PARTICIPANTE
}

enum UserStatus {
  PENDENTE
  ATIVO
  RECUSADO
  REMOVIDO
}

enum MemberStatus {
  PENDENTE
  ATIVO
  RECUSADO
  REMOVIDO
}

enum MatchPhase {
  GRUPOS
  PLAYOFFS
  OITAVAS
  QUARTAS
  SEMI
  FINAL
}

enum MatchStatus {
  AGENDADO
  AO_VIVO
  ENCERRADO
}

enum PredictionResult {
  CASA
  EMPATE
  FORA
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  passwordHash        String
  role                Role                 @default(PARTICIPANTE)
  status              UserStatus           @default(PENDENTE)
  createdAt           DateTime             @default(now())
  predictions         Prediction[]
  scores              Score[]
  boloesCreated       Bolao[]
  bolaoMembers        BolaoMember[]
  passwordResetTokens PasswordResetToken[]
  messagesSent        Message[]            @relation("MessagesSent")
  messagesReceived    Message[]            @relation("MessagesReceived")
  emailChanges         UserEmailChangeAudit[] @relation("EmailChangesForUser")
  emailChangesMade     UserEmailChangeAudit[] @relation("EmailChangesByUser")
}

model Bolao {
  id              String        @id @default(cuid())
  nome            String
  inviteCode      String        @unique @default(cuid())
  status          BolaoStatus   @default(PENDENTE)
  premiacaoRegra  String?       @db.Text
  entradaDireta   Boolean       @default(false)
  createdById     String
  createdBy       User          @relation(fields: [createdById], references: [id])
  members         BolaoMember[]
  predictions     Prediction[]
  scores          Score[]
  createdAt       DateTime      @default(now())
  deletedAt       DateTime?
  messages        Message[]
}

model BolaoMember {
  bolaoId      String
  bolao        Bolao        @relation(fields: [bolaoId], references: [id])
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  role         MemberRole   @default(PARTICIPANTE)
  status       MemberStatus @default(PENDENTE)
  championPick String?

  @@id([bolaoId, userId])
  @@index([bolaoId, status])
  @@index([bolaoId, status, role])
  @@index([userId, status])
}

model Match {
  id          String            @id @default(cuid())
  apiId       Int               @unique
  fifaMatchId String?           @unique
  phase       MatchPhase
  round       Int
  group       String            @default("")
  homeTeam    String
  awayTeam    String
  dateTime    DateTime
  homeScore   Int?
  awayScore   Int?
  homePenalty Int?
  awayPenalty Int?
  result      PredictionResult?
  status      MatchStatus       @default(AGENDADO)
  odds        Odd[]
  predictions Prediction[]

  @@index([status])
  @@index([dateTime])
  @@index([homeTeam, awayTeam, status])
}

model LiveScoreMatch {
  id           Int       @id @default(autoincrement())
  idMatch      String    @unique @map("id_match") @db.VarChar(64)
  idStage      String?   @map("id_stage") @db.VarChar(64)
  homeTeam     String?   @map("home_team")
  awayTeam     String?   @map("away_team")
  homeScore    Int?      @map("home_score")
  awayScore    Int?      @map("away_score")
  homePenalty  Int?      @map("home_penalty")
  awayPenalty  Int?      @map("away_penalty")
  status       String    @default("scheduled") @db.VarChar(32)
  minute       String?   @db.VarChar(32)
  matchDateTime DateTime @map("match_datetime")
  groupName    String?   @map("group_name")
  round        String?
  homeTeamFlag String?   @map("home_team_flag") @db.Text
  awayTeamFlag String?   @map("away_team_flag") @db.Text
  lastUpdated  DateTime  @map("last_updated")

  @@index([status])
  @@index([matchDateTime])
  @@index([status, matchDateTime])
}

model Odd {
  id          String           @id @default(cuid())
  matchId     String
  match       Match            @relation(fields: [matchId], references: [id])
  oddHome     Float
  oddDraw     Float
  oddAway     Float
  favorite    PredictionResult
  capturedAt  DateTime         @default(now())
  predictions Prediction[]

  @@index([matchId, capturedAt])
}

model Prediction {
  id           String           @id @default(cuid())
  bolaoId      String
  bolao        Bolao            @relation(fields: [bolaoId], references: [id])
  userId       String
  user         User             @relation(fields: [userId], references: [id])
  matchId      String
  match        Match            @relation(fields: [matchId], references: [id])
  prediction   PredictionResult
  oddId        String?
  odd          Odd?             @relation(fields: [oddId], references: [id])
  oddTimestamp DateTime?
  correct      Boolean?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([bolaoId, userId, matchId])
  @@index([bolaoId, userId])
  @@index([bolaoId, matchId])
  @@index([bolaoId, correct])
}

model Round {
  id              String     @id @default(cuid())
  phase           MatchPhase
  number          Int
  bonusCalculated Boolean    @default(false)
  scores          Score[]

  @@unique([phase, number])
}

model Score {
  id                String @id @default(cuid())
  bolaoId           String
  bolao             Bolao  @relation(fields: [bolaoId], references: [id])
  userId            String
  user              User   @relation(fields: [userId], references: [id])
  roundId           String
  round             Round  @relation(fields: [roundId], references: [id])
  roundPoints       Float  @default(0)
  bonus             Float  @default(0)
  accumulatedPoints Float  @default(0)

  @@unique([bolaoId, userId, roundId])
  @@index([bolaoId, roundId])
  @@index([bolaoId, userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model UserEmailChangeAudit {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("EmailChangesForUser", fields: [userId], references: [id])
  changedById String
  changedBy   User     @relation("EmailChangesByUser", fields: [changedById], references: [id])
  oldEmail    String
  newEmail    String
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([changedById, createdAt])
}

enum MessageStatus {
  ENVIADA
  LIDA
  RESPONDIDA
}

model Message {
  id         String        @id @default(cuid())
  fromUserId String
  fromUser   User          @relation("MessagesSent", fields: [fromUserId], references: [id])
  toUserId   String?
  toUser     User?         @relation("MessagesReceived", fields: [toUserId], references: [id])
  bolaoId    String?
  bolao      Bolao?        @relation(fields: [bolaoId], references: [id])
  subject    String
  body       String        @db.Text
  status     MessageStatus @default(ENVIADA)
  parentId   String?
  parent     Message?      @relation("MessageReplies", fields: [parentId], references: [id])
  replies    Message[]     @relation("MessageReplies")
  createdAt  DateTime      @default(now())

  @@index([toUserId, status])
  @@index([fromUserId])
  @@index([bolaoId])
}

model SyncStatus {
  key       String   @id
  syncedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
